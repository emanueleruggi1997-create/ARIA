{
  "name": "HumanRequest",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "contact_nome": {
      "type": "string"
    },
    "canale": {
      "type": "string",
      "enum": [
        "whatsapp",
        "instagram"
      ]
    },
    "motivo": {
      "type": "string",
      "description": "Cosa ha detto il cliente"
    },
    "stato": {
      "type": "string",
      "enum": [
        "nuovo",
        "gestito"
      ],
      "default": "nuovo"
    }
  },
  "required": [
    "business_id",
    "contact_nome"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}