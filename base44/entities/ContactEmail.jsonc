{
  "name": "ContactEmail",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID del business"
    },
    "nome": {
      "type": "string",
      "description": "Nome completo"
    },
    "email": {
      "type": "string",
      "description": "Indirizzo email"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tag del contatto"
    },
    "fonte": {
      "type": "string",
      "enum": [
        "whatsapp",
        "instagram",
        "csv",
        "form",
        "manuale"
      ],
      "default": "manuale"
    },
    "stato": {
      "type": "string",
      "enum": [
        "attivo",
        "disiscritto"
      ],
      "default": "attivo"
    }
  },
  "required": [
    "business_id",
    "email"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}