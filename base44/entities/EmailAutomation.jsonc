{
  "name": "EmailAutomation",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "tipo": {
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "attiva": {
      "type": "boolean",
      "default": false
    },
    "template_id": {
      "type": "string"
    },
    "delay_giorni": {
      "type": "number",
      "default": 1
    },
    "invii_totali": {
      "type": "number",
      "default": 0
    },
    "aperture_totali": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "business_id",
    "tipo"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}