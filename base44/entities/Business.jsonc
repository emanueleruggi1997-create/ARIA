{
  "name": "Business",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome del business"
    },
    "settore": {
      "type": "string",
      "description": "Settore di attivit\u00e0"
    },
    "citta": {
      "type": "string"
    },
    "sito_web": {
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "piva": {
      "type": "string"
    },
    "piano": {
      "type": "string",
      "enum": [
        "starter",
        "pro",
        "agency"
      ],
      "default": "starter"
    },
    "wa_number": {
      "type": "string"
    },
    "wa_api_key": {
      "type": "string"
    },
    "wa_connesso": {
      "type": "boolean",
      "default": false
    },
    "ig_username": {
      "type": "string"
    },
    "ig_connesso": {
      "type": "boolean",
      "default": false
    },
    "fb_username": {
      "type": "string"
    },
    "fb_connesso": {
      "type": "boolean",
      "default": false
    },
    "email_provider": {
      "type": "string"
    },
    "email_smtp_host": {
      "type": "string"
    },
    "email_smtp_porta": {
      "type": "string"
    },
    "email_smtp_user": {
      "type": "string"
    },
    "email_smtp_pass": {
      "type": "string"
    },
    "email_connessa": {
      "type": "boolean",
      "default": false
    },
    "email_notifica": {
      "type": "string"
    },
    "email_company_name": {
      "type": "string",
      "description": "Nome azienda nel footer email"
    },
    "email_company_year": {
      "type": "string",
      "description": "Anno nel footer email"
    },
    "email_company_website": {
      "type": "string",
      "description": "Sito web nel footer email"
    },
    "email_reply_to": {
      "type": "string",
      "description": "Email di risposta per campagne"
    },
    "email_logo_url": {
      "type": "string",
      "description": "URL logo aziendale per email"
    },
    "notif_escalation": {
      "type": "boolean",
      "default": true
    },
    "notif_report_settimanale": {
      "type": "boolean",
      "default": false
    },
    "notif_limite_piano": {
      "type": "boolean",
      "default": true
    },
    "tono": {
      "type": "string",
      "enum": [
        "formale",
        "amichevole",
        "professionale",
        "diretto"
      ],
      "default": "professionale"
    },
    "servizi": {
      "type": "string"
    },
    "prezzi": {
      "type": "string"
    },
    "ai_prompt": {
      "type": "string"
    },
    "nome_agente": {
      "type": "string",
      "default": "ARIA"
    },
    "ruolo_agente": {
      "type": "string"
    },
    "lingua": {
      "type": "string",
      "default": "Italiano"
    },
    "cose_da_non_fare": {
      "type": "string"
    },
    "faq": {
      "type": "string"
    },
    "auto_risposta": {
      "type": "boolean",
      "default": true
    },
    "auto_commenti": {
      "type": "boolean",
      "default": false,
      "description": "Se true ARIA risponde automaticamente ai commenti Instagram"
    },
    "orario_inizio": {
      "type": "string",
      "default": "08:00"
    },
    "orario_fine": {
      "type": "string",
      "default": "20:00"
    },
    "giorni_attivi": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "messaggio_fuori_orario": {
      "type": "string"
    },
    "fuori_orario_attivo": {
      "type": "boolean",
      "default": true
    },
    "escalation_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attivo": {
      "type": "boolean",
      "default": true
    },
    "stato_agente": {
      "type": "string",
      "enum": [
        "attivo",
        "pausa",
        "off"
      ],
      "default": "attivo"
    },
    "responsabile_orario_inizio": {
      "type": "string",
      "default": "09:00"
    },
    "responsabile_orario_fine": {
      "type": "string",
      "default": "18:00"
    },
    "responsabile_giorni_attivi": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aria_name": {
      "type": "string",
      "default": "ARIA"
    },
    "aria_color": {
      "type": "string",
      "default": "#3B6EF8"
    },
    "aria_mood": {
      "type": "string",
      "default": "felice"
    },
    "robot_color": {
      "type": "string"
    },
    "robot_name": {
      "type": "string"
    },
    "robot_mood": {
      "type": "string"
    },
    "theme_name": {
      "type": "string",
      "default": "emaral"
    },
    "theme_accent": {
      "type": "string",
      "default": "#3B6EF8"
    },
    "theme_bg": {
      "type": "string",
      "default": "#080A0F"
    },
    "dashboard_bg": {
      "type": "string",
      "default": "pure"
    },
    "font_family": {
      "type": "string",
      "default": "inter"
    },
    "sidebar_mode": {
      "type": "string",
      "default": "expanded"
    },
    "density": {
      "type": "string",
      "default": "normal"
    },
    "custom_bg_url": {
      "type": "string"
    },
    "sync_aria_color": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}