{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "categoria": {
      "type": "string"
    },
    "soggetto": {
      "type": "string"
    },
    "sections": {
      "type": "string",
      "description": "JSON array delle sezioni"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "business_id",
    "nome"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}