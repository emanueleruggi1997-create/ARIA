{
  "name": "Lead",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID del business"
    },
    "contact_id": {
      "type": "string",
      "description": "ID del contatto"
    },
    "nome": {
      "type": "string",
      "description": "Nome del lead"
    },
    "cognome": {
      "type": "string",
      "description": "Cognome del lead"
    },
    "contact_nome": {
      "type": "string",
      "description": "Nome completo (legacy)"
    },
    "email": {
      "type": "string",
      "description": "Email del lead"
    },
    "phone": {
      "type": "string",
      "description": "Telefono / WhatsApp"
    },
    "instagram_username": {
      "type": "string",
      "description": "Instagram handle (es. @username)"
    },
    "azienda": {
      "type": "string",
      "description": "Nome azienda"
    },
    "canale": {
      "type": "string",
      "enum": [
        "whatsapp",
        "instagram",
        "web",
        "manual",
        "csv"
      ],
      "description": "Canale di provenienza"
    },
    "tipo_progetto": {
      "type": "string",
      "description": "Servizio o progetto richiesto"
    },
    "budget_min": {
      "type": "number"
    },
    "budget_max": {
      "type": "number"
    },
    "valore_stimato": {
      "type": "number",
      "description": "Valore stimato opportunit\u00e0"
    },
    "stato": {
      "type": "string",
      "enum": [
        "nuovo",
        "contattato",
        "qualificato",
        "preventivo_inviato",
        "chiuso_vinto",
        "chiuso_perso"
      ],
      "default": "nuovo"
    },
    "note": {
      "type": "string",
      "description": "Note sul lead"
    },
    "note_ai": {
      "type": "string",
      "description": "Note generate da ARIA"
    },
    "marketing_consent": {
      "type": "boolean",
      "description": "Consenso email marketing"
    },
    "data_primo_contatto": {
      "type": "string",
      "format": "date",
      "description": "Data primo contatto"
    }
  },
  "required": [
    "business_id"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}