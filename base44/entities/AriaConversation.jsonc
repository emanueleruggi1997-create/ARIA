{
  "name": "AriaConversation",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Titolo auto-generato dalla conversazione"
    },
    "messages": {
      "type": "string",
      "description": "JSON array dei messaggi"
    },
    "mood": {
      "type": "string",
      "description": "Umore ARIA al momento della conversazione"
    }
  },
  "required": [
    "business_id"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}