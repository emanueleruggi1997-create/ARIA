{
  "name": "MetaConnection",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID utente Base44"
    },
    "access_token": {
      "type": "string",
      "description": "Instagram long-lived access token"
    },
    "meta_user_id": {
      "type": "string",
      "description": "Instagram user ID (ig_account_id)"
    },
    "meta_user_name": {
      "type": "string",
      "description": "Instagram username"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error"
      ],
      "default": "connected"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "granted_scopes": {
      "type": "string",
      "description": "Scopes concessi dall'utente (comma-separated)"
    },
    "fb_connected": {
      "type": "boolean",
      "default": false
    },
    "fb_page_id": {
      "type": "string"
    },
    "fb_page_name": {
      "type": "string"
    },
    "fb_page_token": {
      "type": "string",
      "description": "Page-level token (solo flusso Facebook, non usato in Instagram Business Login)"
    },
    "ig_connected": {
      "type": "boolean",
      "default": false
    },
    "ig_account_id": {
      "type": "string",
      "description": "Instagram Business/Creator account ID"
    },
    "ig_account_name": {
      "type": "string",
      "description": "Instagram username (@handle)"
    },
    "ig_profile_picture_url": {
      "type": "string",
      "description": "URL foto profilo Instagram"
    },
    "ig_token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Scadenza token long-lived (60 giorni)"
    },
    "business_id": {
      "type": "string",
      "description": "ID del business collegato"
    }
  },
  "required": [
    "user_id"
  ]
}