{
  "name": "MetaConnection",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID utente Base44"
    },
    "business_id": {
      "type": "string",
      "description": "ID del business collegato"
    },
    "login_flow": {
      "type": "string",
      "description": "instagram_business_login",
      "default": "instagram_business_login"
    },
    "access_token": {
      "type": "string",
      "description": "Instagram long-lived access token"
    },
    "ig_token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Scadenza token (60 giorni)"
    },
    "granted_scopes": {
      "type": "string",
      "description": "Scopes concessi (comma-separated)"
    },
    "has_basic_scope": {
      "type": "boolean",
      "default": false,
      "description": "instagram_business_basic concesso"
    },
    "has_messages_scope": {
      "type": "boolean",
      "default": false,
      "description": "instagram_business_manage_messages concesso"
    },
    "ig_connected": {
      "type": "boolean",
      "default": false
    },
    "ig_account_id": {
      "type": "string",
      "description": "Instagram user/business account ID"
    },
    "ig_account_name": {
      "type": "string",
      "description": "Instagram @username"
    },
    "ig_profile_picture_url": {
      "type": "string"
    },
    "meta_user_id": {
      "type": "string",
      "description": "Alias ig_account_id"
    },
    "meta_user_name": {
      "type": "string",
      "description": "Alias ig_account_name"
    },
    "fb_connected": {
      "type": "boolean",
      "default": false
    },
    "fb_page_id": {
      "type": "string",
      "description": "Facebook Page ID (solo legacy)"
    },
    "fb_page_name": {
      "type": "string"
    },
    "fb_page_token": {
      "type": "string",
      "description": "Facebook Page token (solo legacy)"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error"
      ],
      "default": "connected"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "sync_error": {
      "type": "string",
      "description": "Ultimo errore di sincronizzazione"
    },
    "webhook_url": {
      "type": "string",
      "description": "URL webhook configurato"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}